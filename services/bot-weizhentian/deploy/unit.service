# 服务单元模板。ops/install.sh 会把它装成 gooday-<目录名>.service。
#
# 占位符 {{NAME}} 由安装脚本按目录名替换，不要手写死。
# 新增服务不需要改 install.sh——它扫描 services/*/deploy/unit.service。

[Unit]
Description=Gooday Harness 威震天（AI 开发）
After=network.target docker.service

# 崩溃循环保护：5 分钟内重启 ≥5 次就进 failed，交巡检升级 P1，而不是无限重启空转烧钱。
# ⚠️ 这两项【必须在 [Unit] 段】。写进 [Service] 时 systemd 会直接忽略并只在日志里
# 留一句 warning——保护看起来配了，实际根本没生效（2026-09-07 复核实测）。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/gooday-harness
EnvironmentFile=/opt/gooday-harness/.env

ExecStart=/usr/bin/python3 /opt/gooday-harness/services/{{NAME}}/main.py

# G01：日志不落进代码目录
StandardOutput=append:/var/log/gooday-harness/{{NAME}}.log
StandardError=append:/var/log/gooday-harness/{{NAME}}.log

# Restart=always 而非 on-failure：
# on-failure 时脚本"正常"退出(return 0)会让服务静静躺平，不重启也不告警。
# 配套：脚本致命错误必须 sys.exit(1)。
Restart=always
RestartSec=10

# 单个服务失控不该拖垮整机（本机 2G）
MemoryMax=600M
MemoryHigh=500M

[Install]
WantedBy=multi-user.target
