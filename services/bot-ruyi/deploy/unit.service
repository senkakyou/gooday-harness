# 服务单元模板。ops/install.sh 会把它装成 gooday-<目录名>.service。
#
# 占位符 {{NAME}} 由安装脚本按目录名替换，不要手写死。
# 新增服务不需要改 install.sh——它扫描 services/*/deploy/unit.service。

[Unit]
Description=Gooday Harness 如意（前台，唯一对外窗口）
After=network.target docker.service

# 崩溃循环保护：5 分钟内重启 ≥5 次就进 failed，交巡检升级 P1，而不是无限重启空转烧钱。
# ⚠️ 这两项【必须在 [Unit] 段】。写进 [Service] 时 systemd 会直接忽略并只在日志里
# 留一句 warning——保护看起来配了，实际根本没生效（2026-09-07 复核实测）。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# ═══ 【这一行是如意「零工具」的真正实现】（2026-09-11 实测后改）════════
#
#   config.json 里写着 allowed_tools: [] 「一个工具都不给」。
#   **那道控制从来没生效过**，而且这套 CLI 的 flag 根本表达不了它：
#     · --allowedTools 不是排他白名单（实测 __none__ / "" 都挡不住 Read）
#     · --disallowedTools 是黑名单，禁掉 Read/Bash/Glob/Grep/Edit/Write 之后
#       模型改用 Monitor 跑 head 把文件读了 —— 没列到的工具就是逃生口
#
#   真正有效的是【沙箱的 cwd 范围】：实测从仓库外的空目录跑，
#   /opt/gooday-harness/.env 和整个仓库都读不到。
#
#   所以把她的工作目录挪出仓库。她读到的每句话都来自不可信来源，
#   而 .env 就在仓库根 —— 一次注入就能让她把 JWT_SECRET 写进回复发给客户。
#   她的 config/prompt 都走绝对路径（HERE），库和 HTTP 都在 Python 侧，
#   挪 cwd 不影响任何功能。
ExecStartPre=/usr/bin/install -d -m 700 /var/lib/gooday-harness/state/bot-ruyi/cwd
WorkingDirectory=/var/lib/gooday-harness/state/bot-ruyi/cwd
EnvironmentFile=/opt/gooday-harness/.env

ExecStart=/usr/bin/python3 /opt/gooday-harness/services/{{NAME}}/main.py

# G01：日志不落进代码目录
StandardOutput=append:/var/log/gooday-harness/{{NAME}}.log
StandardError=append:/var/log/gooday-harness/{{NAME}}.log

# Restart=always 而非 on-failure：
# on-failure 时脚本"正常"退出(return 0)会让服务静静躺平，不重启也不告警。
# 配套：脚本致命错误必须 sys.exit(1)。
Restart=always
RestartSec=10

# 单个服务失控不该拖垮整机（本机 2G）
MemoryMax=600M
MemoryHigh=500M

[Install]
WantedBy=multi-user.target
