// =====================================================
// appsettings.json —— ASP.NET Core 应用配置（生产环境默认值）
// 生产环境的敏感配置（Jwt__Secret 等）通过 docker-compose.yml
// 的 environment 字段覆盖，不在此文件明文存储真实密钥
// =====================================================
{
  // 数据库连接字符串（EF Core 读取此键）
  // 生产环境被 docker-compose 环境变量 ConnectionStrings__Default 覆盖
  "ConnectionStrings": {
    "Default": "Data Source=gooday.db"
  },

  // JWT 认证配置（Program.cs 里读取）
  // Secret 必须至少 32 字符，生产环境务必换成强随机值
  "Jwt": {
    "Secret": "gooday-super-secret-key-2024-must-be-at-least-32-characters-long!!",
    "Issuer": "gooday.ltd",
    "Audience": "gooday.ltd"
  },

  // 课表照片识别配置
  // - Vision:ClaudeUrl  宿主机 Claude CLI OCR 服务地址（scripts/ocr_server.py，docker-compose 已配 http://172.18.0.1:7788）
  //   该服务由 claude CLI 用订阅账号凭据（~/.claude/.credentials.json）识别，不使用任何 API Key
  // 留空则返回 mock 示例草稿
  "Vision": {
    "ClaudeUrl": ""
  },

  // 爱发电支付集成配置（付费订阅功能）
  // Token 和 PlanId 从爱发电开发者后台获取
  "Afdian": {
    "Token": "先留空后面填",
    "PlanId199": "先留空后面填",
    "PlanId299": "先留空后面填",
    "PlanId1688": "先留空后面填"
  },

  // 日志级别：默认 Information，ASP.NET 框架日志降到 Warning 减少噪音
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // 允许的 Host 请求头（"*" = 不限制，生产可改为具体域名）
  "AllowedHosts": "*"
}
