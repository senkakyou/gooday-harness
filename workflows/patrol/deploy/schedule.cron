# runas: root
# replaces: /opt/gooday/scripts/lingxi-coo-patrol.py
# 巡检：每 5 分钟一轮。与旧 patrol 错开 2 分钟，避免同时抢 systemctl/数据库。
# 影子模式下只观察不处置，可以和旧 patrol 安全并行。
2-59/5 * * * * bash -c 'set -a; source /opt/gooday-harness/.env 2>/dev/null; set +a; python3 /opt/gooday-harness/workflows/{{NAME}}/run.py' >> /var/log/gooday-harness/{{NAME}}.log 2>&1
