          "services/bot-weizhentian"
        ]
      },
      {
        "unit": "gooday-harness-bot-zhaocai",
        "deps": [
          "packages/botkit",
          "services/bot-zhaocai"
        ]
      },
      {
        "unit": "gooday-harness-dispatcher",
        "deps": [
