{
  "_readme": "拷贝为 config.json 后修改。旧 patrol 把这些全写死在 707 行代码里，新的抽出来——迁移期指向旧系统，切换后改指向新系统即可，不用改代码。",
  "mode": "shadow",
  "_mode": "shadow=只观察不处置（迁移期必须用这个，否则和旧 patrol 抢着重启服务）；active=发现问题自动处置",
  "services": [
    {
      "unit": "gooday-harness-bot-lingxi",
      "heartbeat": "/var/lib/gooday-harness/state/bot-lingxi/heartbeat",
      "max_silent_min": 12
    },
    {
      "unit": "gooday-harness-bot-ruyi",
      "heartbeat": "/var/lib/gooday-harness/state/bot-ruyi/heartbeat",
      "max_silent_min": 10
    },
    {
      "unit": "gooday-harness-bot-qingtianzu",
      "heartbeat": "/var/lib/gooday-harness/state/bot-qingtianzu/heartbeat",
      "max_silent_min": 20
    },
    {
      "unit": "gooday-harness-bot-weizhentian",
      "heartbeat": "/var/lib/gooday-harness/state/bot-weizhentian/heartbeat",
      "max_silent_min": 35
    },
    {
      "unit": "gooday-harness-bot-zhaocai",
      "heartbeat": "/var/lib/gooday-harness/state/bot-zhaocai/heartbeat",
      "max_silent_min": 10
    },
    {
      "unit": "gooday-harness-dispatcher",
      "heartbeat": "/var/lib/gooday-harness/state/dispatcher/heartbeat",
      "max_silent_min": 10
    }
  ],
  "_services": "旧 gooday-* 已于 2026-09-07 停用并 disable，巡检目标改指新架构。max_silent_min 建议=正常单轮耗时×3。",
  "credentials": [
    {
      "who": "agent",
      "path": "/home/agent/.claude/.credentials.json",
      "required": true,
      "owner": "agent"
    }
  ],
  "_credentials": "required=true 的缺失即 P0。owner 用于属主漂移检测——root 跑的进程重写文件会把属主改掉，把其他身份锁在外面。",
  "backups": [
    {
      "name": "gooday-harness-hourly",
      "dir": "/srv/gooday-harness/backups/gooday/hourly",
      "max_age_hours": 3
    },
    {
      "name": "gooday-legacy-hourly",
      "dir": "/opt/gooday/backups/hourly",
      "max_age_hours": 3
    }
  ],
  "certs": [
    {
      "name": "www.gooday.ltd",
      "port": 443,
      "sni": "www.gooday.ltd",
      "warn_days": 7
    },
    {
      "name": "xray-555",
      "port": 555,
      "sni": "www.gooday.ltd",
      "warn_days": 7
    }
  ],
  "databases": [
    {
      "name": "gooday",
      "path": "/var/lib/docker/volumes/gooday_gooday_data/_data/gooday.db",
      "sanity_table": "Users",
      "sanity_min_rows": 1,
      "slow_query_sec": 3
    }
  ],
  "_databases": "迁移期指向旧库；切换后改指向新库。只读探测，不给已吃紧的库加负担。",
  "repo": "/opt/gooday-harness",
  "_repo": "读各 workflow 的 replaces 声明，检查迁移是否成对完成。",
  "assets": [
    {
      "name": "gooday",
      "db": "/var/lib/docker/volumes/gooday_gooday_data/_data/gooday.db",
      "webroot": "/opt/gooday/src/GoodayTools/wwwroot",
      "queries": [
        [
          "在线工具",
          "SELECT Name, OnlineUrl FROM Tools WHERE IsPublished=1 AND IsOnline=1 AND COALESCE(OnlineUrl,'')<>''"
        ],
        [
          "可下载工具",
          "SELECT Name, '/uploads/'||DownloadFileName FROM Tools WHERE IsPublished=1 AND HasDownload=1 AND COALESCE(DownloadFileName,'')<>''"
        ]
      ]
    }
  ],
  "_assets": "已发布内容的文件还在不在。这类丢失特别危险：页面照常列出来，点进去才 404，后台看起来一切正常。",
  "evolution": {
    "_": "进化闭环巡检。max_age_hours 按闭环的实际跑动频率设，留余量",
    "max_age_hours": 26
  },
  "bot_inbox": {
    "_": "bot 收件箱巡检。dup_limit 是「N 分钟内向同一人发 N 条」的告警线",
    "bot_ids": [
      20,
      21,
      22,
      23,
      25
    ],
    "max_unread_minutes": 15,
    "dup_window_minutes": 10,
    "dup_limit": 3
  },
  "stale_process": {
    "_": "进程比代码旧 = 改了没重启。grace 给刚改完还没重启留余量",
    "grace_minutes": 10,
    "units": [
